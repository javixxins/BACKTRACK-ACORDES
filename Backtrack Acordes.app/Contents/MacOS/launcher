#!/bin/bash
# Lanzador del icono «Backtrack Acordes» (macOS).
# Si el servidor ya está en marcha abre el navegador; si no, pide a Terminal que ejecute
# «Iniciar Backtrack Acordes.command» (macOS no deja a un icono leer Documentos por sí mismo).
# Funciona tanto dentro de la carpeta de la app como copiado al Escritorio.
HERE="$(dirname "$(dirname "$(dirname "$(dirname "$0")")")")"
APP_DIR="$HERE"
if [ ! -f "$APP_DIR/Iniciar Backtrack Acordes.command" ]; then
  APP_DIR="$(cat "$HOME/.backtrack-acordes-dir" 2>/dev/null)"
fi

for P in $(seq 8921 8929); do
  if /usr/bin/curl -s -m 1 "http://127.0.0.1:$P/api/config" | /usr/bin/grep -q '"app": *"backtrack-acordes"'; then
    /usr/bin/open "http://127.0.0.1:$P"
    exit 0
  fi
done

if [ -z "$APP_DIR" ] || [ ! -f "$APP_DIR/Iniciar Backtrack Acordes.command" ]; then
  /usr/bin/osascript -e 'display dialog "No encuentro la carpeta de Backtrack Acordes. Abre una vez «Iniciar Backtrack Acordes.command» desde su carpeta." buttons {"Entendido"} with title "Backtrack Acordes" with icon caution'
  exit 0
fi

/usr/bin/osascript - "$APP_DIR/Iniciar Backtrack Acordes.command" <<'OSA'
on run argv
    tell application "Terminal"
        activate
        do script quoted form of (item 1 of argv)
    end tell
end run
OSA
